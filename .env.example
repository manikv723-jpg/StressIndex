# Copy to .env and fill in. NEVER commit .env — it is gitignored.

PORT=8080

# true  -> 6 simulated friends, no devices or API key needed
# false -> board is empty until real Junction data arrives
DEMO_MODE=true

# Junction dashboard -> Team Config
VITAL_API_KEY=

VITAL_ENV=sandbox
VITAL_REGION=us

# Junction dashboard -> Webhooks -> your endpoint -> Signing Secret (whsec_...)
VITAL_WEBHOOK_SECRET=

# Optional: set to false to disable the 60s heart-rate polling fallback.
# Webhooks are primary; this backstop just keeps the board moving if a
# provider's sync is sparse.
POLL_HEART_RATE=true
